---
// One role or one project, in the main column of a .band section. Role and
// Project (src/content/cv/types.ts) differ in shape — a Role has `org` +
// `title`, a Project has `name` (and optional `links`) — so this component
// takes a deliberately generic prop interface rather than a union of the two:
//
//   title     the accent-coloured heading fragment: a role's `org`, or a
//             project's `name`.
//   subtitle  an optional plain-weight fragment appended after the title
//             with an em dash. Roles pass their `title` (job title) here;
//             projects have nothing equivalent and omit it.
//   links     optional, project-only in practice, but kept generic so the
//             component doesn't know about "roles" or "projects" at all.
//
// The call sites (src/pages/index.astro) do the mapping from each CV shape
// onto this interface; Entry itself only knows about entries.
interface EntryLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  subtitle?: string;
  period: string;
  context?: string;
  bullets: string[];
  links?: EntryLink[];
}

const { title, subtitle, period, context, bullets, links } = Astro.props;
---

<article class="entry">
  <div class="entry-head">
    <h3>
      <span class="entry-title">{title}</span>{subtitle && <span class="entry-subtitle"> — {subtitle}</span>}
    </h3>
    <p class="entry-period">{period}</p>
  </div>
  {context && <p class="entry-context">{context}</p>}
  <ul class="entry-bullets">
    {bullets.map((bullet) => (
      <li>{bullet}</li>
    ))}
  </ul>
  {links && links.length > 0 && (
    <p class="entry-links">
      {links.map((link, index) => (
        <>
          {index > 0 && <span aria-hidden="true"> · </span>}
          <a href={link.href} rel="noopener noreferrer" target="_blank">{link.label}</a>
        </>
      ))}
    </p>
  )}
</article>

<style>
  .entry {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--rule-soft);
  }

  .entry:last-child {
    border-bottom: none;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
  }

  .entry-head h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .entry-title {
    color: var(--accent);
  }

  .entry-subtitle {
    color: var(--ink);
  }

  .entry-period {
    margin: 0;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.78rem;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .entry-context {
    margin: 0.4rem 0 0;
    color: var(--ink-3);
    font-size: 0.9rem;
  }

  .entry-bullets {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .entry-links {
    margin: 0.6rem 0 0;
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  .entry-links a {
    color: var(--accent);
  }
</style>
