---
// The trace strip row — see "Signature: the trace strip" in
// docs/design-direction.md. Every bar is normalised to its own baseline: full
// width is `from`, the filled portion is `to` as a fraction of `from`
// (barFraction), so bars of different units still read against each other on
// one axis — shorter is more debt repaid.
//
// The row owns no column tracks of its own: it is a subgrid of <MetricList>,
// which is what makes the figures column-align across rows.
import type { Metric } from '../content/cv/types';
import { barFraction, formatFigure, formatDelta } from '../lib/metrics';
import { Provenance } from './Provenance';

interface Props {
  metric: Metric;
}

const { metric } = Astro.props;

const fraction = barFraction(metric.from, metric.to);
const fillPercent = fraction * 100;
const fromFigure = formatFigure(metric.from, metric.unit);
const toFigure = formatFigure(metric.to, metric.unit);
const delta = formatDelta(metric.from, metric.to);
// Colour is never the only carrier of meaning: the arrow direction and the
// sign already baked into `delta` both encode up-is-good vs down-is-good.
const arrow = metric.direction === 'up-is-good' ? '↑' : '↓';
// The fill width is carried by a class from a static scale, not by a style
// attribute. A CSP that hashes inline styles cannot whitelist style attributes
// at all — hashes do not apply to them, and CSP3 makes 'unsafe-inline' inert
// once any hash is present — so an attribute here would have blanked every bar
// in the trace strip. A class resolves against the component's own scoped
// stylesheet, which Astro hashes automatically, and it still works with
// JavaScript disabled. Quantised to 0.5%: at most ~2px on a real bar, while
// the exact figures sit beside it in tabular numerals and are never rounded.
const fillStep = Math.round(fillPercent * 2);
---

<div class="metric" data-metric={metric.label} data-direction={metric.direction}>
  <div class="metric-label">{metric.label}</div>
  <div class="metric-track" data-metric-track>
    <div class={`metric-fill w-${fillStep}`} data-metric-fill></div>
  </div>
  {/* display:contents above the collapse point, so the four figures sit in the
      shared tracks rather than in a box of their own; a real flex box below it.
      figure-from / figure-to are alignment hooks: the defect this replaced was
      only visible geometrically, so Task 14's browser run should assert that
      their right edges match across every row. */}
  <div class="metric-figures">
    <span class="figure figure-from">{fromFigure}</span>
    <span class="arrow" aria-hidden="true">{arrow}</span>
    <span class="figure figure-to">{toFigure}</span>
    <span class="delta">{delta}</span>
  </div>
  {metric.verifiedBy && <Provenance client:visible text={metric.verifiedBy} label={metric.label} />}
</div>

