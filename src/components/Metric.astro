  .metric {
    display: grid;
    grid-column: 1 / -1;
    /* Fallback for engines without subgrid: the row keeps its own tracks and
       lays out correctly, it just does not align with its neighbours. */
    grid-template-columns: minmax(8rem, 12rem) minmax(0, 1fr) auto auto auto auto;
    grid-template-columns: subgrid;
    align-items: center;
    row-gap: 0.3rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule-soft);
  }

  .metric-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    /* The shared column gap is tuned for the gaps between figures; label and
       bar want a wider one, taken as padding so the tracks stay aligned. */
    padding-right: 0.55rem;
  }

  .metric-track {
    position: relative;
    height: 0.55rem;
    background: var(--rule-soft);
    border: 1px solid var(--rule);
    overflow: hidden;
    margin-right: 0.55rem;
  }

  .metric-fill {
    position: absolute;
    inset: 0;
    transform-origin: left;
    transform: scaleX(1);
    transition: transform 0.6s ease-out;
  }

  .metric[data-direction='up-is-good'] .metric-fill {
    background: var(--accent);
  }

  .metric[data-direction='down-is-good'] .metric-fill {
    background: var(--ink-3);
  }

  .metric-figures {
    display: contents;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    color: var(--ink-2);
  }

  .figure,
  .arrow,
  .delta {
    white-space: nowrap;
    /* Figures are read as a column, so they hang off their right edge. */
    justify-self: end;
  }

  .arrow {
    color: var(--ink-3);
    justify-self: center;
  }

  .delta {
    color: var(--ink);
    font-weight: 500;
    padding-left: 0.55rem;
  }

  @media (max-width: 30rem) {
    .metric {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.4rem;
    }

    /* Stacked: the figures become a line of their own again. */
    .metric-figures {
      display: flex;
      align-items: baseline;
      gap: 0.4em;
    }

    .metric-label {
      padding-right: 0;
    }

    .metric-track {
      margin-right: 0;
    }

    .figure,
    .arrow,
    .delta {
      justify-self: auto;
    }

    .delta {
      padding-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .metric-fill {
      transition: none !important;
      transform: scaleX(1) !important;
    }
  }

  @media print {
    .metric-track {
      display: none;
    }
  }

  /* The method apparatus: styling for the Provenance island, expressed here
     because Astro's scoped styles can't reach into a child React island's
     rendered markup. This is the apparatus described in
     docs/design-direction.md — small, mono, indented, marked with a dagger —
     applied as presentation over the Provenance component's fixed contract,
     not a second mechanism.

     The note is the content and the toggle is a margin control, so the note
     holds the line and the button sits quietly at its right edge. It was
     previously an underlined link on its own flush-left line, which read
     louder than the note it governs — a UI affordance where the direction
     asks for typography. */
  :global(.provenance) {
    grid-column: 1 / -1;
    /* flow-root so the floated toggle is contained even when the note it
       governs is collapsed and there is no in-flow content to hold it. */
    display: flow-root;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  :global(.provenance p) {
    margin: 0.3rem 0 0 1.4rem;
    padding-left: 0.6rem;
    border-left: 1px solid var(--rule);
  }

  :global(.provenance p::before) {
    content: '\2020  ';
    color: var(--ink-3);
  }

  :global(.provenance button) {
    /* Floated rather than placed in a column: a column would reserve its
       width down the note's whole height, squeezing every wrapped line. The
       float only shortens the lines it actually sits beside. */
    float: right;
    margin: 0.3rem 0 0 1rem;
    font: inherit;
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: inherit;
    background: none;
    border: none;
    padding: 0.15rem 0;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
  }

  :global(.provenance button:hover) {
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  :global(.provenance button:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Stacked: there is no room to float alongside the note without cutting it
     to three words a line, so the toggle drops below it instead. */
  @media (max-width: 30rem) {
    :global(.provenance) {
      display: flex;
      flex-direction: column;
    }

    :global(.provenance p) {
      order: 1;
    }

    :global(.provenance button) {
      order: 2;
      float: none;
      align-self: flex-end;
      margin: 0.25rem 0 0;
    }
  }

  @media print {
    :global(.provenance button) {
      display: none;
    }

    :global(.provenance p) {
      display: block !important;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fills = document.querySelectorAll<HTMLElement>('[data-metric-fill]');

  if (!reduceMotion && fills.length) {
    fills.forEach((fill) => {
      fill.style.transform = 'scaleX(0)';
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting);
        visible.forEach((entry, index) => {
          const fill = entry.target.querySelector<HTMLElement>('[data-metric-fill]');
          if (!fill) return;
          fill.style.transitionDelay = `${index * 60}ms`;
          fill.style.transform = 'scaleX(1)';
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.4 },
    );

    document.querySelectorAll('[data-metric]').forEach((el) => observer.observe(el));
  }
</script>
