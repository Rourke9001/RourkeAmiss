---
import Base from '../layouts/Base.astro';
---
<Base
  title="Rourke Amiss"
  description="Design system scaffold: tokens, fonts and the marginal gutter grid."
  page="home"
>
  <section class="band">
    <div class="gutter">Status</div>
    <div>
      <h1 style="font-family: var(--serif); color: var(--ink); margin: 0 0 0.5em;">Design system online</h1>
      <p style="margin: 0;">
        This page exists to prove that <code>Base.astro</code> and the
        <code>.band</code> gutter grid build and render correctly. Page
        content lives in later tasks.
      </p>
    </div>
  </section>
</Base>
